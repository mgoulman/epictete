{
  "name": "epictete-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:restaurant": "pnpm --filter @epictete/restaurant dev",
    "build:restaurant": "pnpm --filter @epictete/restaurant build",
    "dev:saas": "pnpm --filter @epictete/saas dev",
    "build:saas": "pnpm --filter @epictete/saas build"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@sentry/cli", "sharp", "unrs-resolver", "core-js"]
  }
}
