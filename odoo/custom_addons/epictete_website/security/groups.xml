<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_website_editor" model="res.groups">
        <field name="name">Epictete: Site web</field>
        <field name="comment">Gerer le contenu du site web: menu, categories, images et textes.</field>
    </record>

    <!-- roles that can edit the website content -->
    <record id="epictete_rbac.group_role_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_website_editor'))]"/>
    </record>
    <record id="epictete_rbac.group_role_assistant_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_website_editor'))]"/>
    </record>
    <record id="epictete_rbac.group_role_admin" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_website_editor'))]"/>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_website_editor'))]"/>
    </record>
</odoo>
