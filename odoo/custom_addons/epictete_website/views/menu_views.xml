<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============ Categories ============ -->
    <record id="view_menu_category_list" model="ir.ui.view">
        <field name="name">website.menu.category.list</field>
        <field name="model">website.menu.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="name_en"/>
                <field name="item_count" string="Plats"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_menu_category_form" model="ir.ui.view">
        <field name="name">website.menu.category.form</field>
        <field name="model">website.menu.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="name_en"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="item_ids">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="is_available" widget="boolean_toggle"/>
                            <field name="is_featured" widget="boolean_toggle"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_category" model="ir.actions.act_window">
        <field name="name">Categories du menu</field>
        <field name="res_model">website.menu.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ============ Items ============ -->
    <record id="view_menu_item_list" model="ir.ui.view">
        <field name="name">website.menu.item.list</field>
        <field name="model">website.menu.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="price"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="is_featured" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_menu_item_form" model="ir.ui.view">
        <field name="name">website.menu.item.form</field>
        <field name="model">website.menu.item</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Nom du plat (FR)"/></h1>
                        <field name="name_en" placeholder="Nom du plat (EN)"/>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="price"/>
                            <field name="is_available"/>
                            <field name="is_featured"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="allergens"/>
                            <field name="tags"/>
                        </group>
                    </group>
                    <group string="Description (FR)">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Description (EN)">
                        <field name="description_en" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_menu_item" model="ir.actions.act_window">
        <field name="name">Plats du menu</field>
        <field name="res_model">website.menu.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
