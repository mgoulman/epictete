<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_section_list" model="ir.ui.view">
        <field name="name">website.section.list</field>
        <field name="model">website.section</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="key"/>
            </list>
        </field>
    </record>

    <record id="view_section_form" model="ir.ui.view">
        <field name="name">website.section.form</field>
        <field name="model">website.section</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="is_testimonials" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <separator string="Textes (laisser vide = texte par defaut du site)"/>
                    <field name="field_ids">
                        <list editable="bottom" create="false" delete="false">
                            <field name="sequence" widget="handle"/>
                            <field name="label" readonly="1"/>
                            <field name="value_fr" string="Francais"/>
                            <field name="value_en" string="Anglais"/>
                        </list>
                    </field>
                    <separator string="Temoignages" invisible="not is_testimonials"/>
                    <field name="testimonial_ids" invisible="not is_testimonials">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="author_name"/>
                            <field name="role"/>
                            <field name="content"/>
                            <field name="source"/>
                            <field name="rating"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_section" model="ir.actions.act_window">
        <field name="name">Contenu des pages</field>
        <field name="res_model">website.section</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
