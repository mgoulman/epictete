<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_invoice_scan_wizard_form" model="ir.ui.view">
        <field name="name">account.invoice.scan.wizard.form</field>
        <field name="model">account.invoice.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant douchette">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="partner_id"
                           placeholder="Choisir le fournisseur (optionnel)"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <ol style="margin: 0; padding-left: 1.2em">
                        <li>Scannez vos produits un par un avec la douchette — chaque scan ajoute une ligne.</li>
                        <li>Renseignez <b>Quantité</b>, <b>Prix unitaire</b> (ou directement <b>Montant ligne</b>) sur chaque ligne.</li>
                        <li>Cliquez <b>Enregistrer</b> pour pousser les lignes sur la facture.</li>
                        <li>Sur la facture, ajoutez le fournisseur si besoin, vérifiez, puis <b>Confirmez</b> manuellement.</li>
                    </ol>
                </div>
                <group>
                    <div class="o_row" style="width: 100%">
                        <field name="barcode"
                               autofocus="autofocus"
                               placeholder="Scannez un code-barres..."
                               style="width: 70%"/>
                        <button name="action_scan" type="object"
                                string="Ajouter" class="btn-primary"
                                icon="fa-plus"/>
                    </div>
                    <field name="last_scan_message"
                           class="text-success"
                           invisible="not last_scan_message"/>
                </group>
                <field name="scan_line_ids" nolabel="1"
                       string="Produits scannés">
                    <list editable="bottom" create="false" delete="true">
                        <field name="product_id" readonly="1" optional="hide"/>
                        <field name="name" readonly="1" string="Nom du produit"/>
                        <field name="quantity" string="Quantité" widget="float"/>
                        <field name="price_unit" string="Prix unitaire" widget="float"/>
                        <field name="montant_ligne" string="Montant ligne" widget="float"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Enregistrer"
                            class="btn-primary"
                            icon="fa-save"
                            invisible="not scan_line_ids"/>
                    <button string="Fermer" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>