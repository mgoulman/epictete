<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_invoice_scan_wizard_form" model="ir.ui.view">
        <field name="name">account.invoice.scan.wizard.form</field>
        <field name="model">account.invoice.scan.wizard</field>
        <field name="arch" type="xml">
            <form string="Assistant douchette">
                <group>
                    <field name="move_id" invisible="1"/>
                    <field name="partner_id"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <div class="alert alert-info" role="alert">
                    Scannez vos produits un par un. Chaque scan ajoute une ligne
                    ci-dessous — remplissez quantité et prix unitaire (ou Montant
                    ligne) à la volée, puis cliquez « Transférer sur la facture ».
                </div>
                <group>
                    <div class="o_row" style="width: 100%">
                        <field name="barcode"
                               autofocus="autofocus"
                               placeholder="Scannez un code-barres..."
                               style="width: 70%"/>
                        <button name="action_scan" type="object"
                                string="Ajouter" class="btn-primary"
                                icon="fa-plus"/>
                    </div>
                    <field name="last_scan_message"
                           class="text-success"
                           invisible="not last_scan_message"/>
                </group>
                <field name="scan_line_ids" nolabel="1"
                       string="Produits scannés">
                    <list editable="bottom" create="false" delete="true">
                        <field name="product_id" readonly="1" optional="hide"/>
                        <field name="name" readonly="1" string="Nom du produit"/>
                        <field name="quantity" string="Quantité" widget="float"/>
                        <field name="price_unit" string="Prix unitaire" widget="float"/>
                        <field name="montant_ligne" string="Montant ligne" widget="float"/>
                    </list>
                </field>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Transférer sur la facture"
                            class="btn-primary"
                            invisible="not scan_line_ids"/>
                    <button string="Fermer" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>