<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_invoice_scan_wizard" model="ir.ui.view">
        <field name="name">account.move.form.invoice.scan.wizard</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_scan_wizard" type="object"
                        string="Assistant douchette"
                        class="btn-secondary"
                        icon="fa-barcode"
                        invisible="move_type != 'in_invoice' or state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>