# Option A — Google Places API (New). Get a key: https://console.cloud.google.com (enable "Places API (New)")
GOOGLE_PLACES_API_KEY=

# Option A — Hunter.io (domain search + email verifier). https://hunter.io/api-keys
HUNTER_API_KEY=

# Optional caps so you don't blow through free-tier quotas
HUNTER_MAX_DOMAINS=40
HUNTER_VERIFY=1
