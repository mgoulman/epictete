# ─── Database ───────────────────────────────────────────────────────────────
# Two modes:
#
# 1) PRODUCTION (Vercel + Neon): set DATABASE_URL and leave the DB_* vars blank.
#    Use Neon's POOLED connection string (host contains "-pooler").
# DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# 2) LOCAL DEV: leave DATABASE_URL unset and use the discrete vars below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=slowbob
DB_PASSWORD=slowbob
DB_NAME=epictete_db

# ─── Auth (custom JWT) ──────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-use-a-long-random-string

# ─── Supabase (legacy, only required if the browser client is still used) ───
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=

# ─── WhatsApp / Twilio ──────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_RESTAURANT_NUMBER=

# ─── LaCaisse POS sync ──────────────────────────────────────────────────────
LACAISSE_LOGIN=
LACAISSE_PASSWORD=
LACAISSE_CAISSE_ID=

# ─── Vercel Blob (file uploads) ─────────────────────────────────────────────
# Create a Blob store at: https://vercel.com/dashboard → Storage → Create Database → Blob
# Then run `vercel env pull .env.local` or copy the token from the dashboard.
BLOB_READ_WRITE_TOKEN=

# ─── Optional integrations ──────────────────────────────────────────────────
META_ACCESS_TOKEN=
MCP_API_KEY=
